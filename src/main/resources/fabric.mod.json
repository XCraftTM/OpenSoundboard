{
  "schemaVersion": 1,
  "id": "opensoundboard",
  "version": "${version}",

  "name": "OpenSoundboard",
  "description": "A feature-rich soundboard mod for Simple Voice Chat, providing high-quality audio playback and easy management.",
  "authors": [
    "XCraftTM"
  ],
  "contact": {},

  "license": "MIT",
  "icon": "assets/opensoundboard/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "de.xcrafttm.opensoundboard.OpenSoundboardClient"
    ],
    "modmenu": [
      "de.xcrafttm.opensoundboard.integration.ModMenuIntegration"
    ],
    "voicechat": [
      "de.xcrafttm.opensoundboard.integration.SoundboardPlugin"
    ]
  },

  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": ">=${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=${javaVersion}",
    "voicechat": ">=${voicechatVersion}"
  },
  "suggests": {
    "modmenu": ">=${modmenuVersion}"
  }
}
