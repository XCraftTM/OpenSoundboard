{
  "schemaVersion": 1,
  "id": "opensoundboard",
  "version": "${version}",

  "name": "OpenSoundboard",
  "description": "A feature-rich soundboard mod for Simple Voice Chat, providing high-quality audio playback and easy management.",
  "authors": [
    "XCraftTM"
  ],
  "contact": {},

  "license": "MIT",
  "icon": "assets/opensoundboard/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "de.xcrafttm.opensoundboard.OpenSoundboardClient"
    ],
    "voicechat": [
      "de.xcrafttm.opensoundboard.integration.SoundboardPlugin"
    ]
  },

  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "*",
    "voicechat": "*"
  }
}
