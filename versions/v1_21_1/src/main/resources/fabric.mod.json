{
  "schemaVersion": 1,
  "id": "opensoundboard",
  "version": "${version}",
  "name": "OpenSoundboard",
  "description": "A feature-rich soundboard mod for Simple Voice Chat, providing high-quality audio playback and easy management.",
  "authors": ["XCraftTM"],
  "license": "MIT",
  "icon": "assets/opensoundboard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["de.xcrafttm.opensoundboard.OpenSoundboardClient"],
    "voicechat": ["de.xcrafttm.opensoundboard.integration.SoundboardPlugin"],
    "modmenu": ["de.xcrafttm.opensoundboard.integration.ModMenuIntegration"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.21 <1.21.2",
    "voicechat": ">=${voicechat_version}",
    "owo-lib": ">=${owo_version}"
  }
}

